#include <stdio.h>
#include <math.h>

int main() {
    int num, originalNum, remainder, n = 0;
    double result = 0.0;

    // 1. Take input from the user
    printf("Enter an integer: ");
    scanf("%d", &num);

    originalNum = num;

    // 2. Count the number of digits
    while (originalNum != 0) {
        originalNum /= 10;
        n++;
    }

    // Reset originalNum to the input value for the next step
    originalNum = num;

    // 3. Calculate the sum of the power of individual digits
    while (originalNum != 0) {
        remainder = originalNum % 10;
        result += pow(remainder, n);
        originalNum /= 10;
    }

    // 4. Check if the number is an Armstrong number
    // (Using a small epsilon check because pow() returns a double)
    if ((int)round(result) == num) {
        printf("%d is an Armstrong number.\n", num);
    } else {
        printf("%d is not an Armstrong number.\n", num);
    }

    return 0;
}
